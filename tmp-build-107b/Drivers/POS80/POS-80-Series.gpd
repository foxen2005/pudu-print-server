*Feature: zjPaperCutting
{
        *Name: "Paper Cutting"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "After one page"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *Cmd: ""
        }
    }
    *Option: Option2
    {        
        *Name: "After documnet"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *Cmd: ""
        }
    }
    *Option: zjNoCutting
    {
        *Name: "No Cutting[No Feeding]"
    }
    *Option: Option4
    {
        *Name: "Page[No Cutting]"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *Cmd: ""
        }
    }
    *Option: Option5
    {
        *Name: "Documnet[No Cutting]"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *Cmd: ""
        }
    }
}

*Switch: zjPaperCutting
{
    *Case: Option1
    {
        *Command: CmdEndPage
        {
            *Order: PAGE_FINISH.20
            *CallbackID: =CMDID_CUTTING_AFTER_PAGE
        }
    }
    *Case: Option2
    {
        *Command: CmdEndDoc
        {
            *Order: JOB_FINISH.20
            *Cmd: "<1D>V<01>"
        }
    }
    *Case: zjNoCutting
    {
        *Command: CmdEndDoc
        {
            *Order: JOB_FINISH.20
            *Cmd: ""
        }
    }
    *Case: Option4
    {
        *Command: CmdEndPage
        {
            *Order: JOB_FINISH.20
            *Cmd: ""
        }
    }
    *Case: Option5
    {
        *Command: CmdEndDoc
        {
            *Order: JOB_FINISH.20
            *Cmd: ""
        }
    }
} 

*Feature: BeeperSetting
{
        *Name: "Beeper"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: zjBeepBeforePage
    *Option: zjNoBeep
    {
        *Name: "No Beeping"
    }
    *Option: zjBeepAfterPage
    {
        *Name: "Beep after every page"
        *Command: CmdSelect
        {
            *Order: PAGE_FINISH.2 
            *CallbackID: =CMDID_BEEP_AFTER_PAGE
        }
    }
    *Option: zjBeepBeforePage
    {
        *Name: "Beep before every page"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.1
            *Cmd: "<1B420401>"
        }
    }    
    *Option: zjBeepAfterDoc
    {
        *Name: "Beep after every document"
        *Command: CmdSelect
        {
            *Order: JOB_FINISH.2 
            *Cmd: "<1B420401>"
        }
    }
    *Option: zjBeepBeforeDoc
    {
        *Name: "Beep before every document"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *Cmd: "<1B420401>"
        }
    }  
}

*Feature: PrintNVLogo
{
        *Name: "NV Logo"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: Option1

    *Option: Option1
    {
        *Name: "Do not print NV Logo"
    }
    *Option: Option2
    {
        *Name: "Print NV Logo1"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<01001B>a<00>"
        }
    }
    *Option: Option3
    {
        *Name: "Print NV Logo2"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<02001B>a<00>"
        }
    }
    *Option: Option4
    {
        *Name: "Print NV Logo3"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<03001B>a<00>"
        }
    }
    *Option: Option5
    {
        *Name: "Print NV Logo4"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<04001B>a<00>"
        }
    }
    *Option: Option6
    {
        *Name: "Print NV Logo5"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *Cmd: "<1B>a<011C>p<05001B>a<00>"
        }
    }
    *Option: Option7
    {
        *Name: "Print NV Logo6"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<06001B>a<00>"
        }
    }
    *Option: Option8
    {
        *Name: "Print NV Logo7"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<07001B>a<00>"
        }
    }
    *Option: Option9
    {
        *Name: "Print NV Logo8"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1B>a<011C>p<08001B>a<00>"
        }
    }
}


*Command: CmdCR: ""
*Command: CmdLF: ""
*Command: CmdFF: ""
*%OptimizeLeftBound?: FALSE

*RotateCoordinate?: TRUE
*RotateFont?: TRUE
