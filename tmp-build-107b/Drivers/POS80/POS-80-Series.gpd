*GPDSpecVersion: "1.0"
*GPDFileName: "ZJPOS80.GPD"
*GPDFileVersion: "1.0"
*Include: "stdnames.gpd"
*ModelName: "POS80"
*MasterUnits: PAIR(203, 203)
*ResourceDLL:"POS-80-SeriesRES.dll"
*PrinterType: SERIAL
*%*PrintRate: 120
*%*PrintRateUnit: LPM


*Macros: COMMAND_ID
{
    CMDID_BEEP_AFTER_PAGE: 50
    CMDID_CUTTING_AFTER_PAGE: 51
}


*%
*% Orientation
*%
*Feature: Orientation
{
	*rcNameID: =ORIENTATION_DISPLAY
	*DefaultOption: PORTRAIT
	*Option: PORTRAIT
	{
		*rcNameID: =PORTRAIT_DISPLAY
		*Command: CmdSelect
		{
			*Order: DOC_SETUP.6
			*Cmd: ""
		}
	}
	*Option: LANDSCAPE_CC270
	{
		*rcNameID: =LANDSCAPE_DISPLAY
		*Command: CmdSelect
		{
			*Order: DOC_SETUP.8
			*Cmd: ""
		}
	}
}

*%
*% Input bin
*%
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: MANUAL

    *Option: MANUAL
    {
        *rcNameID: =MANUAL_FEED_DISPLAY
        *Command: CmdSelect
        {
         	*Order: DOC_SETUP.11
         	*Cmd: ""
        }
    }
}

*%
*% Resolution
*%
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1

    *Option: Option1
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 203)
        *TextDPI: PAIR(203, 203)
        *PinsPerLogPass: 24
        *SpotDiameter: 170
        *Command: CmdSendBlockData { *Cmd : "<1D>v0<00>" %l{NumOfDataBytes /24} "<1800>"}
    }
}

*%
*% Paper size
*%
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Name:"Thermal Paper(80 x 210)"

        *PageDimensions: PAIR(576, 1678)
        *PrintableArea: PAIR(576, 1678)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option2
    {
        *Name:"Thermal Paper(80 x 297)"

        *PageDimensions: PAIR(576, 2374)
        *PrintableArea: PAIR(576, 2374)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option3
    {
        *Name:"Thermal Paper(80 x 3276)"

        *PageDimensions: PAIR(576, 26182)
        *PrintableArea: PAIR(576, 26182)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: CUSTOMSIZE
    {
        *rcNameID: =USER_DEFINED_SIZE_DISPLAY
        *MinSize: PAIR(576, 480)
        *MaxSize: PAIR(576, 31969)
        *MaxPrintableWidth: 576
        *MinLeftMargin: 0
        *CenterPrintable?: TRUE
    }
}

*%
*% Color mode
*%
*Feature: ColorMode
{
    *rcNameID: =COLOR_PRINTING_MODE_DISPLAY
    *DefaultOption: MONO

    *Option: MONO
    {
        *rcNameID: =MONO_DISPLAY
        *DrvBPP: 1
        *DevNumOfPlanes: 0
        *DevBPP: 0
        *IPCallbackID: 1
        *Color?: FALSE
    }
}

*%
*% Halftone
*%
*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO

    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_16x16_M
    {
        *Name: "16x16"
    }
    *Option: HT_PATSIZE_14x14_M
    {
        *Name: "14x14"
    }
    *Option: HT_PATSIZE_12x12_M
    {
        *Name: "12x12"
    }
    *Option: HT_PATSIZE_10x10_M
    {
        *Name: "10x10"
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *Name: "8x8"
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *Name: "6x6"
    }
    *Option: HT_PATSIZE_4x4_M
    {
        *Name: "4x4"
    }
}

*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *Cmd: "<1B>@"
} 

%*Command: CmdEndDoc
%{
%    *Order: JOB_FINISH.20
%    *Cmd: "<0A><1D>V<01>"
%}


%*Command: CmdEndJob
%{
%    *Order: JOB_FINISH.21
%    *Cmd: "<0A0A0A1B>r<1D>T<1B>@"
%}

*Command: CmdEndJob
{
    *Order: JOB_FINISH.21
    *Cmd: "<1B>r<1D>T<1B>@"
}

%*Command: CmdEndPage
%{
%    *Order: PAGE_FINISH.1
%    *Cmd: "<1D>S"
%}

*Feature: zjPrintMode
{
    *Name: "Print Mode"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: zjGraphMode

    *Option: zjGraphMode
    {
        *Name: "Print as image"
        *Command:CmdSelect
        {
            *CallbackID: 10
            *Order: DOC_SETUP.12
        }
    }
    *Option: zjSoftFontMode
    {
        *Name: "Print as soft font"
        *Command:CmdSelect
        {
            *CallbackID: 11
            *Order: DOC_SETUP.12
        }
    }
}

*Feature: zjCashDrawer
{
        *Name: "Cash Drawer"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: zjEject1BeforePrint

    *Option: zjNoCashDrawer
    {
        *Name: "No Cash Drawer"
        *Command:CmdSelect
        {
        }
    }
    *Option: zjEject1BeforePrint
    {
        *Name: "Open cash drawer #1 before printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>p<004050>"
        }
    }
    *Option: zjEject2BeforePrint
    {
        *Name: "Open cash drawer #2 before printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>p<014050>"
        }
    }
    *Option: zjEject12BeforePrint
    {
        *Name: "Open cash drawer #1+#2 before printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>p<0040501B>p<014050>"
        }
    }
    *Option: zjEject1AfterPrint
    {
        *Name: "Open cash drawer #1 after printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>q<004050>"
        }
    }
    *Option: zjEject2AfterPrint
    {
        *Name: "Open cash drawer #2 after printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>q<014050>"
        }
    }
    *Option: zjEject12AfterPrint
    {
        *Name: "Open cash drawer #1+#2 after printing"
        *Command:CmdSelect
        {
            *Order: JOB_SETUP.1
            *Cmd: "<1B>q<0040501B>q<014050>"
        }
    }
}

*Feature: zjPrintTrailingMarginOrNot
{
        *Name: "Blank space at page's end"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: zjNotPrintTrailingMargin

    *Option: zjPrintTrailingMargin
    {
        *Name: "Print"
        *Command:CmdSelect
        {
            *CallbackID: 20
            *Order: DOC_SETUP.5
        }
    }
    *Option: zjNotPrintTrailingMargin
    {
        *Name: "Do not print"
        *Command:CmdSelect
        {
            *CallbackID: 19
            *Order: DOC_SETUP.5
        }
    }
}

