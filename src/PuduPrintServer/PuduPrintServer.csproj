<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Pudu Print Server</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StartupObject>PuduPrintServer.App</StartupObject>
    <ApplicationIcon>Assets\pudu-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\pudu-logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- SumatraPDF portátil para imprimir los tickets de caja (PDF con TED). Ver tools/README.md.
         Condition Exists: el build no falla si el binario aún no fue colocado. -->
    <None Include="..\..\tools\SumatraPDF.exe" Condition="Exists('..\..\tools\SumatraPDF.exe')">
      <Link>SumatraPDF.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.7" />
    <PackageReference Include="System.IO.Ports" Version="9.0.7" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>