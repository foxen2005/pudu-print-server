<Window x:Class="PuduPrintServer.Dialogs.ImpresoraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de impresoras" Width="560" Height="640"
        WindowStartupLocation="CenterOwner" Background="#111"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Estilo de botón con plantilla propia: respeta el Background oscuro
             y mantiene el texto legible en todos los estados (incluido deshabilitado) -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Items de los desplegables: texto negro legible sobre fondo claro -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Lista de impresoras configuradas -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Impresoras configuradas" FontSize="16" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,12"/>
            <ListView x:Name="ListImpresoras" Background="#1A1A1A" BorderBrush="#333"
                      Foreground="White" Height="180" SelectionChanged="ListImpresoras_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Zona" Width="120" DisplayMemberBinding="{Binding ZonaNombre}"/>
                        <GridViewColumn Header="Tipo" Width="60"  DisplayMemberBinding="{Binding TipoConexion}"/>
                        <GridViewColumn Header="Impresora / Puerto" Width="240" DisplayMemberBinding="{Binding Destino}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Content="Eliminar" x:Name="BtnEliminar" Click="BtnEliminar_Click"
                        Background="#7F1D1D" Foreground="White" BorderThickness="0"
                        Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Probar conexión" x:Name="BtnProbar" Click="BtnProbar_Click"
                        Background="#1E3A5F" Foreground="White" BorderThickness="0"
                        Padding="12,6" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <!-- Formulario agregar/editar (con scroll para no cortar contenido) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Agregar impresora"
                           FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                <!-- Zona -->
                <TextBlock Text="ZONA DE PRODUCCIÓN" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbZona" FontSize="13" Padding="10,8" Margin="0,0,0,14"
                          Background="White" Foreground="Black" BorderBrush="#333"
                          DisplayMemberPath="Nombre"/>
                <!-- Tipo -->
                <TextBlock Text="TIPO DE CONEXIÓN" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbWin" Content="Windows (USB)" GroupName="Tipo"
                                 Foreground="White" IsChecked="True" Margin="0,0,16,0"
                                 Checked="TipoConexion_Changed"/>
                    <RadioButton x:Name="RbCom" Content="COM / Serial" GroupName="Tipo"
                                 Foreground="White" Checked="TipoConexion_Changed"/>
                </StackPanel>
                <!-- Impresora de Windows (tipo WIN) -->
                <StackPanel x:Name="PanelWin">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IMPRESORA DE WINDOWS" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄" Click="BtnRefrescarWin_Click"
                                Background="#2A2A2A" Padding="8,3" FontSize="11" ToolTip="Recargar lista"/>
                    </Grid>
                    <ComboBox x:Name="CmbImpresoraWin" FontSize="13" Padding="10,8" Margin="0,4,0,4"
                              Background="White" Foreground="Black" BorderBrush="#333"/>
                    <TextBlock x:Name="LblContadorWin" FontSize="10" Foreground="#555" Margin="0,0,0,12"/>
                </StackPanel>
                <!-- Puerto COM (tipo COM) — auto-detectado -->
                <StackPanel x:Name="PanelCom" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PUERTO COM DETECTADO" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄" Click="BtnRefrescarCom_Click"
                                Background="#2A2A2A" Padding="8,3" FontSize="11" ToolTip="Recargar puertos"/>
                    </Grid>
                    <ComboBox x:Name="CmbCom" FontSize="13" Padding="10,8" Margin="0,4,0,4"
                              Background="White" Foreground="Black" BorderBrush="#333"/>
                    <TextBlock x:Name="LblContadorCom" FontSize="10" Foreground="#555" Margin="0,0,0,12"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Estado + botón Agregar (fijo, siempre visible) -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LblMsg" FontSize="11" Foreground="#888" Margin="0,0,0,8"/>
            <Button Content="Agregar impresora" Click="BtnAgregar_Click"
                    Background="#7C3AED" Foreground="White" BorderThickness="0"
                    Padding="0,10" FontSize="13" FontWeight="Bold"/>
        </StackPanel>

        <!-- Cuenta / cerrar sesión + cerrar -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Border Height="1" Background="#242424" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="⏻ Cerrar sesión" Click="BtnCerrarSesion_Click"
                        Background="#7F1D1D" BorderThickness="0"
                        Padding="16,10" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Content="Cerrar" Click="BtnCerrar_Click"
                        Background="#333" BorderThickness="0" Padding="28,10"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
