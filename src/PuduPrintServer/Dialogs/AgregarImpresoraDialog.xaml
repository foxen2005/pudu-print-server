<Window x:Class="PuduPrintServer.Dialogs.AgregarImpresoraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar impresora" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" Background="#111"
        ResizeMode="NoResize">
    <!-- 1.0.7 (docs/plans/2026-11-13-impresoras-genericas-sin-driver.md): asistente para térmicas sin driver:
         1) cómo está conectada, 2) cuál es, 3) nombre y papel → prueba e instalación en Windows. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#222"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="Paso" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Agregar impresora térmica" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Funciona sin el driver del fabricante: el ticket sale con timbre y logo igual."
                       Foreground="#888" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="1. ¿Cómo está conectada?" Style="{StaticResource Paso}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3">
            <Button x:Name="BtnRed" Content="🌐  Red (cable/WiFi)" Margin="0,0,6,0" Click="BtnTipo_Click" Tag="Red"/>
            <Button x:Name="BtnUsb" Content="🔌  USB" Margin="3,0" Click="BtnTipo_Click" Tag="Usb"/>
            <Button x:Name="BtnCom" Content="📶  Bluetooth" Margin="6,0,0,0" Click="BtnTipo_Click" Tag="Com"/>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock x:Name="LblPaso2" Text="2. Elige la impresora" Style="{StaticResource Paso}"/>
                <Button x:Name="BtnBuscar" Content="🔄 Buscar de nuevo" HorizontalAlignment="Right"
                        Padding="10,4" FontSize="11" Margin="0,10,0,4" Click="BtnBuscar_Click" IsEnabled="False"/>
            </Grid>
            <ListBox x:Name="ListaEncontradas" Grid.Row="1" Background="#1A1A1A" Foreground="#DDD"
                     BorderBrush="#333" FontSize="13" SelectionChanged="ListaEncontradas_SelectionChanged"/>
            <TextBlock x:Name="LblEstado" Grid.Row="2" Foreground="#888" FontSize="12" Margin="0,6,0,0"
                       TextWrapping="Wrap" Text="Elige cómo está conectada para buscarla."/>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock Text="3. Nombre y papel" Style="{StaticResource Paso}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNombre" Grid.Column="0" Padding="8,6" FontSize="13" Margin="0,0,8,0"
                         Background="#1A1A1A" Foreground="White" BorderBrush="#333"/>
                <ComboBox x:Name="CmbAncho" Grid.Column="1" SelectedIndex="0" FontSize="13">
                    <ComboBoxItem Content="80 mm" Tag="576"/>
                    <ComboBoxItem Content="58 mm" Tag="384"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="LblIpFija" Grid.Row="4" Foreground="#FBBF24" FontSize="11" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Si el router le cambia la IP, el agente la vuelve a encontrar por su MAC. Igual conviene fijarle la IP en el router."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnPrueba" Content="🖨 Imprimir prueba" Margin="0,0,8,0" Click="BtnPrueba_Click" IsEnabled="False"/>
            <Button x:Name="BtnInstalar" Content="Instalar" Background="#7C3AED" Click="BtnInstalar_Click" IsEnabled="False"/>
            <Button Content="Cerrar" Margin="8,0,0,0" Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
